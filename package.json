{
  "name": "huertita",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "description": "Juego de huerta urbana agroecológica del Gran Buenos Aires. Las reglas salen de los datos de huertapp.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:artifact": "tsc --noEmit && vite build --mode artifact && tsx scripts/a-artifact.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tipos": "tsc --noEmit",
    "bot": "tsx tools/bot.ts",
    "dorado": "tsx tools/dorado.ts",
    "datos:sync": "tsx scripts/sync-datos.ts",
    "datos:check": "tsx scripts/sync-datos.ts --check",
    "humo": "tsx tools/humo.ts",
    "lint": "eslint . --max-warnings=10",
    "formato": "prettier --write \"{src,datos,tests,tools,scripts}/**/*.{ts,tsx,css}\" \"*.{ts,js}\"",
    "formato:ver": "prettier --check \"{src,datos,tests,tools,scripts}/**/*.{ts,tsx,css}\" \"*.{ts,js}\"",
    "capturas": "tsx tools/capturas.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "preact": "^10.29.8"
  }
}
