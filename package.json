{
  "name": "huertita",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "Juego de huerta urbana agroecológica del Gran Buenos Aires. Las reglas salen de los datos de huertapp.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:artifact": "tsc --noEmit && vite build --mode artifact && tsx scripts/a-artifact.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tipos": "tsc --noEmit",
    "bot": "tsx tools/bot.ts",
    "datos:sync": "tsx scripts/sync-datos.ts",
    "datos:check": "tsx scripts/sync-datos.ts --check",
    "humo": "tsx tools/humo.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.0",
    "vitest": "^2.1.0"
  }
}
